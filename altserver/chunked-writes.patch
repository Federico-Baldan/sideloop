         throw ServerError(ServerErrorCode::DeviceWriteFailed);
     }
     
-    uint32_t bytesWritten = 0;
-    
-    while (bytesWritten < data.size())
+    std::vector<char> buffer(1024 * 1024);
+    while (file.read(buffer.data(), buffer.size()) || file.gcount() > 0)
     {
-        uint32_t count = 0;
+        uint32_t length = (uint32_t)file.gcount();
+        uint32_t bytesWritten = 0;
         
-        if (afc_file_write(client, af, (const char *)data.data() + bytesWritten, (uint32_t)data.size() - bytesWritten, &count) != AFC_E_SUCCESS)
+        while (bytesWritten < length)
         {
-            throw ServerError(ServerErrorCode::DeviceWriteFailed);
+            uint32_t count = 0;
+            
+            if (afc_file_write(client, af, buffer.data() + bytesWritten, length - bytesWritten, &count) != AFC_E_SUCCESS || count == 0)
+            {
+                afc_file_close(client, af);
+                throw ServerError(ServerErrorCode::DeviceWriteFailed);
+            }
+            
+            bytesWritten += count;
         }
-        
-        bytesWritten += count;
-    }
-    
-    if (bytesWritten != data.size())
-    {
-        throw ServerError(ServerErrorCode::DeviceWriteFailed);
     }
     
     afc_file_close(client, af);
